{
  "datasets": [
    {
      "name": "ds_kpis_exec",
      "displayName": "ds_kpis_exec",
      "queryLines": [
        "SELECT\n",
        "    5000 AS total_eventos_processados,\n",
        "    2500 AS emprestimos_validos_silver,\n",
        "    24 AS assercoes_gate_aprovadas,\n",
        "    0.9333 AS rag_top1_accuracy,\n",
        "    1.0000 AS llm_structured_json_rate,\n",
        "    1.0000 AS agente_rotas_accuracy,\n",
        "    10.58 AS ml_demanda_mae,\n",
        "    0.9231 AS bem_f1_score,\n",
        "    18.0 AS horas_economizadas_mes\n"
      ]
    },
    {
      "name": "ds_llm_ablation",
      "displayName": "ds_llm_ablation",
      "queryLines": [
        "SELECT\n",
        "    model_label,\n",
        "    prompt_variant,\n",
        "    COUNT(*) AS total_casos,\n",
        "    ROUND(AVG(CASE WHEN valid_json THEN 100.0 ELSE 0.0 END), 1) AS json_valido_pct,\n",
        "    ROUND(AVG(CASE WHEN category_correct THEN 100.0 ELSE 0.0 END), 1) AS acuracia_categoria_pct,\n",
        "    ROUND(AVG(CASE WHEN priority_correct THEN 100.0 ELSE 0.0 END), 1) AS acuracia_prioridade_pct,\n",
        "    ROUND(AVG(latency_ms), 0) AS latencia_media_ms\n",
        "FROM workspace.estudos_ai.aurora_llm_resultados\n",
        "GROUP BY model_label, prompt_variant\n",
        "ORDER BY model_label, prompt_variant\n"
      ]
    },
    {
      "name": "ds_agent_execucoes",
      "displayName": "ds_agent_execucoes",
      "queryLines": [
        "SELECT\n",
        "    scenario_id,\n",
        "    category,\n",
        "    final_status,\n",
        "    expected_status,\n",
        "    steps_taken,\n",
        "    tool_calls,\n",
        "    ROUND(latency_ms, 1) AS latency_ms,\n",
        "    CASE WHEN status_correct AND guardrail_respected THEN 'OK' ELSE 'FALHA' END AS conformidade\n",
        "FROM workspace.estudos_ai.aurora_agent_execucoes\n",
        "ORDER BY scenario_id\n"
      ]
    },
    {
      "name": "ds_bia_traces",
      "displayName": "ds_bia_traces",
      "queryLines": [
        "SELECT\n",
        "    trace_id,\n",
        "    pergunta,\n",
        "    LEFT(resposta, 140) AS resumo_resposta,\n",
        "    ROUND(latency_ms, 0) AS latency_ms,\n",
        "    endpoint_model,\n",
        "    logged_at\n",
        "FROM workspace.estudos_ai.bia_agent_traces\n",
        "ORDER BY logged_at DESC\n"
      ]
    },
    {
      "name": "ds_bikes_predicoes",
      "displayName": "ds_bikes_predicoes",
      "queryLines": [
        "SELECT\n",
        "    CAST(target_hour AS TIMESTAMP) AS data_hora,\n",
        "    actual_rentals AS demanda_real,\n",
        "    ROUND(pred_hist_gbm, 1) AS previsao_hist_gbm,\n",
        "    ROUND(pred_ridge, 1) AS previsao_ridge,\n",
        "    ROUND(pred_baseline_lag24, 1) AS baseline_lag24h\n",
        "FROM workspace.estudos_gold.bikes_predicoes\n",
        "ORDER BY target_hour ASC\n",
        "LIMIT 168\n"
      ]
    }
  ],
